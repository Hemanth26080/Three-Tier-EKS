# ==========================================
# 1. Terraform
# ==========================================
# Local .terraform directory (plugins and modules)
**/.terraform/*
**/.terraform/

# Terraform state files (contain sensitive infrastructure secrets and credentials)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
tfplan*

# Terraform crash logs
crash.log
crash.*.log

# Sensitive variable files (passwords, tokens)
*.tfvars
*.tfvars.json
# Note: Keep example templates versioned:
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and lock info
.terraformrc
terraform.rc
.terraform.tfstate.lock.info

# ==========================================
# 2. Node.js & React (Backend & Frontend)
# ==========================================
# Dependencies
**/node_modules/

# Production build outputs
**/build/
**/dist/

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/logs/
*.log

# Environment variables (API keys, DB secrets)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Editor directories and caches
**/.eslintcache
**/.cache/

# ==========================================
# 3. Kubernetes, Cloud & Secrets
# ==========================================
# Kubeconfig and certificates
kubeconfig*
*.kubeconfig
*.pem
*.key
*.crt

# If you use real production secrets, exclude them (keep templates like secrets.example.yaml)
# k8s/secrets.yaml

# Helm packages
*.tgz

# ==========================================
# 4. OS & IDE Specific Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
